<section class="catalog-wrap">
  <div class="container">
    <div class="catalog-header">
      <h2 class="catalog-title">Репродукции</h2>
      <ul class="catalog-tabs">
        <li class="catalog-tab">
          <button class="button catalog-tab-button is-active" type="button" data-tab="fr">Франция</button>
        </li>
        <li class="catalog-tab">
          <button class="button catalog-tab-button" type="button" data-tab="ge">Германия</button>
        </li>
        <li class="catalog-tab">
          <button class="button catalog-tab-button" type="button" data-tab="uk">Англия</button>
        </li>
      </ul>
    </div>
    <div class="catalog">
      {% for code, items in catalog %}
        <ul class="catalog-content{% if loop.index == 1 %} is-active{% endif %}" data-tab-content="{{ code }}">
          {% for item in items %}
            {{ ui.catalogItem(item) }}
          {% endfor %}
        </ul>
      {% endfor %}
    </div>
  </div>
</section>
