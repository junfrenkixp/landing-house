{% extends 'common/templates/layout/_default.twig' %}

{% block title %}Landing House{% endblock %}

{% block head %}
    <link rel="stylesheet" href="./assets/css/landing-house.css">
{% endblock %}

{% block content %}
    {% include 'common/templates/landing-house/_header.twig' %}
    {% include 'common/templates/landing-house/_hero.twig' %}
    {% include 'common/templates/landing-house/_catalog.twig' %}
    {% include 'common/templates/landing-house/_new-collection.twig' %}
    {% include 'common/templates/landing-house/_team.twig' %}
    {% include 'common/templates/landing-house/_footer.twig' %}

    <script>
      const tabs = document.querySelectorAll('.catalog-tab-button');
      const tabsContent = document.querySelectorAll('.catalog-content');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          tabs.forEach(tab => {tab.classList.remove('is-active')});
          tab.classList.add('is-active');

          const dataTab = tab.dataset.tab;

          tabsContent.forEach(tabContent => {
            const dataTabContent = tabContent.dataset.tabContent;
            tabContent.classList.toggle('is-active', dataTab === dataTabContent);
          })
        })
      })
    </script>
{% endblock %}
